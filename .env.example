# Copy to .env and fill with real values. Never commit .env.
# cp .env.example .env

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Site & CORS ────────────────────────────────────────────
# Optional in local dev. When unset, server derives URL from request host.
SITE_URL=http://localhost:3000
# Comma-separated origins for cross-origin API requests.
# Leave empty for same-origin deployments.
CORS_ALLOWED_ORIGINS=

# ── Supabase (required for /api routes) ────────────────────
# Supabase dashboard → Project Settings → API
# Use service role key ONLY on server side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── SMTP (required for verification/reset emails) ──────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-secret
# Set true only if your SMTP provider allows a custom from address.
SMTP_ALLOW_CUSTOM_FROM=false
FROM_EMAIL=mailer@example.com
FROM_NAME=WATT Protocol
CONTACT_EMAIL=support@wattprotocol.io

# ── Auth/session hardening (set in non-test environments) ──
SESSION_SECRET=replace-with-strong-random-secret
AUTH_SALT=replace-with-long-random-salt
# Legacy fallback secret still read by the server.
ADMIN_KEY=

# ── Admin login (required for /api/admin/*) ────────────────
ADMIN_EMAIL=admin@wattprotocol.io
# Prefer ADMIN_PASSWORD_HASH in production (scrypt hash via server hashSecret()).
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── Optional spam/domain controls ───────────────────────────
DISPOSABLE_EMAIL_DOMAINS=

# ── Internal watt-minter (Base Sepolia payouts) ─────────────
# Production: https://watt-minter.onrender.com (no trailing slash)
WATT_MINTER_URL=https://watt-minter.onrender.com
WATT_MINTER_SECRET=
WATT_CONTRACT_ADDRESS=0xf07ce10cE718fEe22dFEe06B4048B734bC95b954
